// Copy to Secrets.xcconfig (git-ignored) for a private debug build. Never commit the real file.
// SHOPPER_API_KEY: the shared dev APP_API_KEY. SHOPPER_TEAM: your Apple team id (Xcode > Settings > Accounts).
// SHOPPER_BUNDLE_ID: must be unique for a free personal team, e.g. dev.<yourname>.worthit
SHOPPER_API_KEY = paste-the-dev-key-here
SHOPPER_TEAM =
SHOPPER_BUNDLE_ID = dev.yourname.worthit
