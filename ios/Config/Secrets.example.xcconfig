// Copy to Secrets.xcconfig (git-ignored) for a build that talks to the backend. Never commit the real file.
// CHECKPRICE_API_KEY: the shared dev deployment's APP_API_KEY (Convex dashboard > Settings > Environment variables).
CHECKPRICE_API_KEY = paste-the-dev-key-here
// Canned demo, off by default. Uncomment to make "Scan Screen with Check Price" always answer BUY with More Details,
// with no text reading, no backend call and no saved check. Debug builds only; it is not a real verdict.
// SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CHECKPRICE_DEMO_BUY
